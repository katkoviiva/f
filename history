 1838  nano spitest.py
 1839  # spitest.py
 1840  # A brief demonstration of the Raspberry Pi SPI interface, using the Sparkfun
 1841  # Pi Wedge breakout board and a SparkFun Serial 7 Segment display:
 1842  # https://www.sparkfun.com/products/11629
 1843  import time
 1844  import spidev
 1845  # We only have SPI bus 0 available to us on the Pi
 1846  bus = 0
 1847  #Device is the chip select pin. Set to 0 or 1, depending on the connections
 1848  device = 1
 1849  # Enable SPI
 1850  spi = spidev.SpiDev()
 1851  # Open a connection to a specific bus and device (chip select pin)
 1852  spi.open(bus, device)
 1853  # Set SPI speed and mode
 1854  spi.max_speed_hz = 500000
 1855  spi.mode = 0
 1856  # Clear display
 1857  msg = [0x76]
 1858  spi.xfer2(msg)
 1859  time.sleep(5)
 1860  # Turn on one segment of each character to show that we can
 1861  # address all of the segments
 1862  i = 1
 1863  while i < 0x7f:;
 1864      msg = [0x77];     msg.append(i)
